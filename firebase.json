{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/about",
        "destination": "/about.html"
      },
      {
        "source": "/work",
        "destination": "/work.html"
      },
      {
        "source": "/contact",
        "destination": "/contact.html"
      },
      {
        "source": "/book-consultation",
        "destination": "/book-consultation.html"
      },
      {
        "source": "/service/service",
        "destination": "/service/service.html"
      },
      {
        "source": "/service/graphic-design",
        "destination": "/service/graphic-design.html"
      },
      {
        "source": "/service/seo-ai-search-optimization",
        "destination": "/service/seo-ai-search-optimization.html"
      },
      {
        "source": "/service/ui-ux-design",
        "destination": "/service/ui-ux-design.html"
      },
      {
        "source": "/service/website-development",
        "destination": "/service/website-development.html"
      }
    ]
  }
}
