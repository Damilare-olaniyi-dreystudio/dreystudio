{
  "hosting": {
    "site": "drey-studio",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.git/**",
      "**/.firebase/**",
      "**/node_modules/**",
      "**/*.bak",
      "**/*.backup",
      "**/*.sessionbak",
      "firebase-debug.log",
      "NUL"
    ],
    "cleanUrls": true,
    "redirects": [
      {"source": "/about.html", "destination": "/about", "type": 301},
      {"source": "/contact.html", "destination": "/contact", "type": 301},
      {"source": "/work.html", "destination": "/work", "type": 301},
      {"source": "/service.html", "destination": "/service", "type": 301},
      {"source": "/book-consultation.html", "destination": "/book-consultation", "type": 301},
      {"source": "/pricing.html", "destination": "/pricing", "type": 301},
      {"source": "/service/service.html", "destination": "/service/service", "type": 301},
      {"source": "/service/website-development.html", "destination": "/service/website-development", "type": 301},
      {"source": "/service/ui-ux-design.html", "destination": "/service/ui-ux-design", "type": 301},
      {"source": "/service/graphic-design.html", "destination": "/service/graphic-design", "type": 301},
      {"source": "/service/seo-ai-search-optimization.html", "destination": "/service/seo-ai-search-optimization", "type": 301},
      {"source": "/website-developer-ibadan.html", "destination": "/website-developer-ibadan", "type": 301},
      {"source": "/website-developer-lagos.html", "destination": "/website-developer-lagos", "type": 301},
      {"source": "/website-developer-abuja.html", "destination": "/website-developer-abuja", "type": 301},
      {"source": "/website-developer-port-harcourt.html", "destination": "/website-developer-port-harcourt", "type": 301},
      {"source": "/website-developer-nigeria.html", "destination": "/website-developer-nigeria", "type": 301},
      {"source": "/work/Nexus-Construction.html", "destination": "/work/Nexus-Construction/", "type": 301},
      {"source": "/work/idera-estate.html", "destination": "/work/idera-estate/", "type": 301},
      {"source": "/work/skincare-website.html", "destination": "/work/skincare-website/", "type": 301},
      {"source": "/work/lumina-estates.html", "destination": "/work/lumina-estates/", "type": 301},
      {"source": "/work/Nexus-Construction", "destination": "/work/Nexus-Construction/", "type": 301},
      {"source": "/work/idera-estate", "destination": "/work/idera-estate/", "type": 301},
      {"source": "/work/skincare-website", "destination": "/work/skincare-website/", "type": 301}
    ],
    "rewrites": [
      {"source": "/blog", "destination": "/blog/index.html"},
      {"source": "/blog/", "destination": "/blog/index.html"},
      {"source": "/work/Nexus-Construction/", "destination": "/work/Nexus-Construction.html"},
      {"source": "/work/idera-estate/", "destination": "/work/idera-estate.html"},
      {"source": "/work/skincare-website/", "destination": "/work/skincare-website.html"},
      {"source": "/work/lumina-estates/", "destination": "/work/lumina-estates.html"},
      {"source": "/about", "destination": "/about.html"},
      {"source": "/work", "destination": "/work.html"},
      {"source": "/contact", "destination": "/contact.html"},
      {"source": "/book-consultation", "destination": "/book-consultation.html"},
      {"source": "/pricing", "destination": "/pricing.html"},
      {"source": "/service/service", "destination": "/service/service.html"},
      {"source": "/service/graphic-design", "destination": "/service/graphic-design.html"},
      {"source": "/service/seo-ai-search-optimization", "destination": "/service/seo-ai-search-optimization.html"},
      {"source": "/service/ui-ux-design", "destination": "/service/ui-ux-design.html"},
      {"source": "/service/website-development", "destination": "/service/website-development.html"},
      {"source": "/website-developer-ibadan", "destination": "/website-developer-ibadan.html"},
      {"source": "/website-developer-lagos", "destination": "/website-developer-lagos.html"},
      {"source": "/website-developer-abuja", "destination": "/website-developer-abuja.html"},
      {"source": "/website-developer-port-harcourt", "destination": "/website-developer-port-harcourt.html"},
      {"source": "/website-developer-nigeria", "destination": "/website-developer-nigeria.html"}
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {"key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400"}
        ]
      },
      {
        "source": "/output.css",
        "headers": [
          {"key": "Cache-Control", "value": "public, max-age=172800, must-revalidate"}
        ]
      },
      {
        "source": "/blog/**",
        "headers": [
          {"key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400"}
        ]
      }
    ]
  }
}
